	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>ai.carmonai</groupId>
	<artifactId>carmonai</artifactId>
	<version>1.0.0</version>
	<packaging>pom</packaging>

	<modules>
		<module>api/account</module>
		<module>api/account-service</module>
		<module>api/auth</module>
		<module>api/auth-service</module>
		<module>api/organization</module>
		<module>api/organization-service</module>
		<module>api/gateway-service</module>
	</modules>

</project>
